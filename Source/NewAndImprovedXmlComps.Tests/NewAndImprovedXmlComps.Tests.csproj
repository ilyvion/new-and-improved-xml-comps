<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <UseLaboratory>true</UseLaboratory>
        <RootNamespace>NewAndImprovedXmlComps.Tests</RootNamespace>
        <AssemblyName>NewAndImprovedXmlComps.Tests</AssemblyName>
    </PropertyGroup>
    <!--
        Dev-only test assembly, run in-game via DevTools
        (https://github.com/ilyvion/SmashPhil-DevTools.git).
        It builds into the same <version>/Assemblies folder as the mod assembly, next to the
        DevTools.dll that the DevTools reference below also builds into that folder.

        It's listed in NewAndImprovedXmlComps.sln so it always builds locally (default
        Configuration is Debug), but NewAndImprovedXmlComps.sln deliberately omits a
        Release|Any CPU.Build.0 line for this project's GUID, so a Release-configuration build
        (what CI/release always use, per rimworld-utils' build_mod.yml) skips building it, and
        DevTools, entirely; neither DLL lands in a shipped release.
    -->
    <!--
        Without the DevTools reference (see below), this project has no Publicize items of its
        own, so Krafs.Publicizer's generated IgnoresAccessChecksToAttribute merely shadows the
        one already made public inside the referenced NewAndImprovedXmlComps assembly; CS0436 is
        harmless here.
    -->
    <PropertyGroup Condition="'$(RimWorldVersion)' != '1.6'">
        <NoWarn>$(NoWarn);CS0436</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\NewAndImprovedXmlComps\NewAndImprovedXmlComps.csproj">
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <!--
        This mod's tests build for RimWorld 1.6 only, the one supported version DevTools also
        supports. For any other RimWorldVersion this project builds as an empty assembly: both the
        test sources and the DevTools reference are excluded below. DevTools' own OutDir is
        relative to its clone location, so it's redirected to this mod's <version>/Assemblies
        folder.
    -->
    <ItemGroup Condition="'$(RimWorldVersion)' == '1.6'">
        <ProjectReference
            Include="$(ProjectDependenciesBasePath)\Third-Party\DevTools\DevTools\DevTools.csproj"
            AdditionalProperties="RimWorldVersion=$(RimWorldVersion);OutDir=$(MSBuildThisFileDirectory)..\..\$(RimWorldVersion)\Assemblies\"
        >
            <CopyLocal>False</CopyLocal>
            <Private>false</Private>
        </ProjectReference>
        <Publicize Include="Assembly-CSharp:RimWorld.CompSpawner.TickIntervalDelta" />
        <Publicize Include="Assembly-CSharp:RimWorld.Building_Enterable.startTick" />
        <Publicize Include="Assembly-CSharp:RimWorld.Building_GrowthVat.DrawAt" />
        <Publicize Include="Assembly-CSharp:RimWorld.Building_GrowthVat.TryGrowEmbryo" />
        <Publicize Include="Assembly-CSharp:RimWorld.HumanEmbryo.BestAvailableGrowthVat" />
        <Publicize Include="Assembly-CSharp:RimWorld.Building_GravEngine.DrawAt" />
        <Publicize Include="Assembly-CSharp:RimWorld.StunHandler.stunFromEMP" />
    </ItemGroup>
    <ItemGroup Condition="'$(RimWorldVersion)' != '1.6'">
        <Compile Remove="**/*.cs" />
    </ItemGroup>
</Project>
